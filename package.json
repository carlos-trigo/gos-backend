{
  "name": "gos-backend",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Carlos Trigo <ctrigose@gmail.com>",
  "scripts": {
    "build": "patch-package && tsc",
    "start:dev": "nodemon src/index.ts",
    "start:prod": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "test": "jest",
    "clear-port-80": "sudo lsof -t -i tcp:80 -s tcp:listen | sudo xargs kill",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@jest/globals": "29.7.0",
    "auto-bind": "5.0.1",
    "body-parser": "2.2.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "eslint": "9.25.1",
    "express": "5.1.0",
    "express-jwt": "^8.5.1",
    "express-oauth2-jwt-bearer": "^1.6.1",
    "jwks-rsa": "^3.2.0",
    "patch-package": "^8.0.0",
    "pg": "8.15.6",
    "postinstall-postinstall": "^2.1.0",
    "ts-jest": "29.3.2",
    "ts-sql-query": "^1.65.0"
  },
  "devDependencies": {
    "@types/body-parser": "1.19.5",
    "@types/cors": "2.8.17",
    "@types/eslint": "9.6.1",
    "@types/express": "5.0.1",
    "@types/node": "22.15.0",
    "@types/pg": "8.11.14",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "jest": "^29.7.0",
    "nodemon": "3.1.10",
    "supertest": "7.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
